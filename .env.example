# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=la28
POSTGRES_PASSWORD=changeme
POSTGRES_DB=la28db
# Full URL consumed by SQLAlchemy engine and Alembic env.py.
# Inside Docker the hostname is "db" (the compose service name).
# Outside Docker use "localhost" instead.
DATABASE_URL=postgresql+psycopg2://la28:changeme@db:5432/la28db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Google Maps / Places ─────────────────────────────────────────────────────
# Server-side only — never expose to the frontend or commit to git.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── GTFS Static feeds ────────────────────────────────────────────────────────
# Comma-separated list of GTFS .zip URLs — all feeds are merged in one ingest.
# LA Metro publishes rail and bus separately; list both to cover all venues.
GTFS_STATIC_URLS=https://gitlab.com/LACMTA/gtfs_rail/-/raw/master/gtfs_rail.zip,https://gitlab.com/LACMTA/gtfs_bus/-/raw/master/gtfs_bus.zip

# ── GTFS-Realtime vehicle positions ──────────────────────────────────────────
# Comma-separated JSON endpoints.  LACMTA = bus, LACMTA_Rail = rail.
GTFS_RT_VEHICLES_URLS=https://api.metro.net/LACMTA/vehicle_positions/all,https://api.metro.net/LACMTA_Rail/vehicle_positions/all
GTFS_RT_API_KEY=

# ── Other existing keys ───────────────────────────────────────────────────────
SWIFTLY_API_KEY=your_swiftly_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
SPIN_GBFS_BASE_URL=https://gbfs.spin.pm/api/gbfs/v2_3/los_angeles
BIRD_GBFS_BASE_URL=https://mds.bird.co/gbfs/v2/public/los-angeles
LA_METRO_GBFS_BASE_URL=https://gbfs.bcycle.com/bcycle_lametro
